[
  {
    "name": "add_element",
    "description": "Insert one raw HTML element as a top-level object in a slide, optionally after a target. Returns the element id when one was assigned.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Deck HTML path. Relative paths resolve against the server working directory."
        },
        "slideId": {
          "type": "string",
          "minLength": 1,
          "description": "Slide id such as \"s1\" or \"body\"."
        },
        "html": {
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "elementId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "elementId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "selector": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "selector"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Exactly one of: elementId (data-ppt-el), selector (matches one element), or path (child indices from the slide)."
        }
      },
      "required": [
        "path",
        "slideId",
        "html"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "add_slide",
    "description": "Add one slide after the last slide or after a given slide id, and return the new slide id.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Deck HTML path. Relative paths resolve against the server working directory."
        },
        "html": {
          "type": "string"
        },
        "afterSlideId": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "transition": {
          "type": "string",
          "enum": [
            "none",
            "fade",
            "slide"
          ],
          "description": "Slide transition."
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "create_deck",
    "description": "Create a new deck file. Refuses to overwrite an existing file. Custom HTML is normalized and validated.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Deck HTML path. Relative paths resolve against the server working directory."
        },
        "title": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "slides": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "html": {
          "type": "string"
        },
        "runtime": {
          "type": "boolean",
          "description": "Include the presentation runtime. Defaults to true."
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "delete_slide",
