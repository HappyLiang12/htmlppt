  {
    "name": "export_deck",
    "description": "Export a deck as standalone HTML, PDF, or one PNG per slide. PDF and PNG require a system Chrome, Edge, or Chromium.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Deck HTML path. Relative paths resolve against the server working directory."
        },
        "format": {
          "type": "string",
          "enum": [
            "html",
            "pdf",
            "png"
          ],
          "default": "html",
          "description": "html writes a cleaned standalone file; pdf and png render the slides."
        },
        "outDir": {
          "type": "string",
          "minLength": 1,
          "description": "Output directory. Defaults to the deck directory."
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
