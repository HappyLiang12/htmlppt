{
  "name": "htmlppt",
  "version": "0.0.0",
  "description": "Visual editor, CLI, and MCP server for self-contained HTML presentations",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": {
    "htmlppt": "./dist/cli.js",
    "htmlppt-mcp": "./dist/mcp.js"
  },
  "files": ["dist", "README.md", "LICENSE", "SECURITY.md"],
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
